# Backend selection. Set ONE of the following.

# Cloudflare (recommended): the URL of your deployed Worker (see cloudflare/README.md).
# When set, the app uses Cloudflare Workers + Durable Objects and ignores Supabase.
VITE_API_BASE=https://openlectern-api.your-subdomain.workers.dev

# Supabase (alternative): only used when VITE_API_BASE is empty.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-public-key
